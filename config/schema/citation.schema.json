{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarttextcoderox.local/schema/citation.schema.json",
  "title": "CITATION.cff (offline stub aligned to CFF 1.2.0 required keys)",
  "type": "object",
  "required": ["cff-version", "message", "title", "authors"],
  "properties": {
    "cff-version": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": ["string", "number"] },
    "date-released": { "type": "string" },
    "license": { "type": "string" },
    "repository-code": { "type": "string" },
    "type": { "type": "string", "enum": ["software", "dataset"] },
    "abstract": { "type": "string" },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "family-names": { "type": "string" },
          "given-names": { "type": "string" },
          "orcid": { "type": "string" },
          "email": { "type": "string" },
          "affiliation": { "type": "string" }
        },
        "anyOf": [
          { "required": ["name"] },
          { "required": ["family-names"] }
        ]
      }
    }
  }
}
