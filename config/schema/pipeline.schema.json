{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarttextcoderox.local/schema/pipeline.schema.json",
  "title": "STCX Pipeline DAG",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes"],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "step"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ST(0[0-9]|1[0-6])$"
          },
          "step": { "type": "string", "minLength": 1 },
          "needs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
