# SmartTextCoderoX environment template
# Copy to .env and fill secrets. Never commit .env.

# Workspace root for runtime dirs (cache/data/logs/reports/results/temp).
# Default: repository root. Example: E:\github\_workspaces
# STCX_WORKSPACES_ROOT=

# LLM API keys (MS2+). Names are references only; never log values.
# STCX_LLM_DEEPSEEK_API_KEY=
# STCX_LLM_ZHIPU_API_KEY=
