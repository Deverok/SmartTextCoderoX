# --- Secrets & local env ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# --- Node / GUI (MS5) ---
node_modules/
apps/**/dist/

# --- Runtime zone (spec §3.0) ---
cache/
temp/
logs/
results/
reports/
runs/

# data: ignore all except _example
data/*
!data/_example/
!data/_example/**

# models: weights not in git; keep README
models/**
!models/README.md
!models/**/.gitkeep

# bin: only .gitkeep in git
bin/**
!bin/.gitkeep
!bin/**/.gitkeep

# lib/bin: large binaries downloaded at build time
lib/bin/**
!lib/bin/.gitkeep

# --- IDE / OS ---
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs ---
*.log
